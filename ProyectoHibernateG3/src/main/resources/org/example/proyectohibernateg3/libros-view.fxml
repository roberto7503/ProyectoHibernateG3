<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="550.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.proyectohibernateg3.controller.LibroController">
    <children>
        <Label layoutX="20.0" layoutY="20.0" text="Registro de libros">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <!-- Columna izquierda: Título, Autor y Año -->
        <Label layoutX="20.0" layoutY="65.0" text="Título:" />
        <TextField fx:id="txtTitulo" layoutX="70.0" layoutY="60.0" prefWidth="200.0" promptText="Título del libro" />

        <Label layoutX="20.0" layoutY="105.0" text="Autor:" />
        <TextField fx:id="txtAutor" layoutX="70.0" layoutY="100.0" prefWidth="200.0" promptText="Autor del libro" />

        <Label layoutX="20.0" layoutY="145.0" text="Año:" />
        <TextField fx:id="txtAnio" layoutX="70.0" layoutY="140.0" prefWidth="200.0" promptText="Año de publicación" />

        <!-- Columna derecha: Precio y Categoría -->
        <Label layoutX="310.0" layoutY="65.0" text="Precio:" />
        <TextField fx:id="txtPrecio" layoutX="380.0" layoutY="60.0" prefWidth="200.0" promptText="Precio (ej. 15.50)" />

        <Label layoutX="310.0" layoutY="105.0" text="Categoría:" />
        <ComboBox fx:id="cmbCategoria" layoutX="380.0" layoutY="100.0" prefWidth="200.0" promptText="Seleccionar categoría" />

        <!-- Botones de acción -->
        <Button fx:id="btnGuardar" layoutX="20.0" layoutY="200.0" mnemonicParsing="false" onAction="#guardarLibro" text="Guardar libro" />
        <Button fx:id="btnModificar" layoutX="120.0" layoutY="200.0" mnemonicParsing="false" onAction="#modificarLibro" text="Modificar libro" />
        <Button fx:id="btnEliminar" layoutX="230.0" layoutY="200.0" mnemonicParsing="false" onAction="#eliminarLibro" text="Eliminar libro" />
        <Button fx:id="btnLimpiar" layoutX="335.0" layoutY="200.0" mnemonicParsing="false" onAction="#limpiarCampos" text="Limpiar campos" />
        <Button fx:id="btnCargar" layoutX="530.0" layoutY="200.0" mnemonicParsing="false" onAction="#cargarLibros" text="Cargar libros" />

        <!-- Tabla con columna Categoría incluida -->
        <TableView fx:id="tblLibros" layoutX="20.0" layoutY="245.0" prefHeight="280.0" prefWidth="610.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />
                <TableColumn fx:id="colTitulo" prefWidth="165.0" text="Título" />
                <TableColumn fx:id="colAutor" prefWidth="130.0" text="Autor" />
                <TableColumn fx:id="colAnio" prefWidth="65.0" text="Año" />
                <TableColumn fx:id="colPrecio" prefWidth="85.0" text="Precio" />
                <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría" />
            </columns>
        </TableView>
    </children>
</AnchorPane>