<?xml version="1.0" encoding="UTF-8" ?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.2">
    <persistence-unit name="bibliotecaPU" transaction-type="RESOURCE_LOCAL">
        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>
        <class>org.example.proyectohibernateg3.model.Libro</class>
        <class>org.example.proyectohibernateg3.model.Categoria</class>
        <properties>
            <!--PostgreSQL-->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/bdbiblioteca"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>

            <!--Hibernate: 'update' crea o actualiza las tablas sin romper el SessionFactory-->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

        </properties>
    </persistence-unit>
</persistence>